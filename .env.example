# ===== Filmora WebUI 配置 =====
# WebUI 管理员密码（登录用）
ADMIN_PASSWORD=admin123
# 会话签名密钥（生产环境务必改成随机长字符串）
SECRET_KEY=change-me-to-a-long-random-string

# 数据目录（容器内 /data 挂载到卷）
DATA_DIR=./data
PORT=8000
HOST=0.0.0.0

# 上传上限（MB）
MAX_UPLOAD_MB=2048

# 对外可访问的基础地址（OpenAI API 返回绝对 URL 用）
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 静态 API Keys（逗号分隔，可选；动态 key 在 WebUI 内管理）
API_KEYS=

# ---- 文生视频引擎 ----
# local = 内置本地生成器（离线可跑，直接产出 MP4）
# openai = 转发到外部 OpenAI 兼容视频 API
T2V_PROVIDER=local
T2V_API_BASE=
T2V_API_KEY=
T2V_MODEL=filmora-t2v
EDIT_MODEL=filmora-video-edit

# ---- 语音转写 / 字幕 ----
# 模型: tiny / base / small / medium / large-v3（越大越准越慢）
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_LANG=auto
